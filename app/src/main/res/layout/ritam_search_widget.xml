<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_search_pill"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_search_hint"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#91D5AE" />

        <TextView
            android:id="@+id/widget_search_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_search_hint"
            android:textColor="#E1E3E1"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_voice_btn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_pill_bg"
        android:contentDescription="@string/widget_voice_desc"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="#91D5AE" />

    <ImageButton
        android:id="@+id/widget_private_btn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_pill_bg"
        android:contentDescription="@string/widget_private_desc"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_secure"
        android:tint="#C5CEF2" />
</LinearLayout>
